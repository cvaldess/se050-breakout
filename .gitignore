# KiCad backups and autosaves
*.bak_*
*.kicad_pcb-bak
*.kicad_sch-bak
_autosave-*
*-backups/

# Check reports, regenerated on demand
*-drc.rpt
*-erc.rpt

# Local editor / cache state (machine-specific, not part of the design)
*.kicad_prl
fp-info-cache
.history/

# Exported artefacts that are regenerated from the board
# (gerber/ is committed on purpose so people can order without opening KiCad)
*.zip
*.step
*.stp
!SE050E2HQ1.pretty/*.stp

# Panelisation and assembly outputs. Anyone who wants to fabricate this board
# has everything they need in the project files and gerber/; the panel is our
# own production run and is not part of what is published here.
panelize.py
se050_breakout_panel.*
gerber_panel/
assembly/

# Local bench notes
experimento-c17.txt

# KiCad lock files and library backups
~*.lck
*.bak
